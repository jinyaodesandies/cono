#!/usr/bin/env python3
"""cono-check — Cono's checking component as a local web app.

The browser shows live video of your page (getUserMedia — any camera it
can see, including iPhone Continuity). Nothing streams anywhere: the page
diffs the video locally, and only when you pause writing does it snap one
full-resolution frame and send it here, where Claude (`claude` CLI — your
Claude Code login, no API key) reads it and reports:

  visibility n/10   what the camera can actually see
  on your page      faithful transcription, student's errors preserved
  check             hint-first: where the mistake is, never the answer

Usage:
  cono-check                     # live camera, picked in the browser
  cono-check demo                # no camera needed: bundled sample session
  cono-check --model opus        # pick the model (default: sonnet)
  cono-check --replay DIR        # replay any recorded session directory
  cono-check --port 9000
  cono-check --no-open           # don't open the browser automatically
Ctrl-C to stop.
"""
import csv, json, re, shutil, signal, subprocess, sys, threading, time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

HERE = Path(__file__).resolve().parent
INDEX = HERE / "index.html"
SAMPLE = HERE / "sample"

# replay-mode gating (live mode gates in the browser with the same numbers)
DIRTY_AT = 0.20       # changed_frac above this = real activity (writing, hand)
STABLE_AT = 0.10      # changed_frac below this = calm enough to read
MAX_WAIT = 5          # analyze anyway after this many frames of activity

PROMPT = """You are Cono, an AI study tutor watching a student's paper through a camera (a top-down or handheld view of the page). Read the image file: {path}

Respond in EXACTLY this plain-text format, no markdown:

VISIBILITY: n/10 - one line: what the camera sees; whether a page is in frame and which edges are cut off; whether small details (exponents, subscripts, fraction bars) are readable; note blur or glare.
ON PAGE: transcribe what is written on the page exactly as written, preserving the student's own errors - never silently correct anything. If no page or writing is visible, say what IS visible instead.
CHECK: 1-3 sentences checking the work. If there is a mistake, say exactly where it is (which line or step) and ask a guiding question - do not give the corrected answer. If the work looks right so far, confirm it and suggest the next step. If nothing is readable, give one concrete tip to fix the framing."""


class State:
    """Everything the UI needs, guarded by one lock."""
    def __init__(self):
        self.lock = threading.Lock()
        self.status = "watching"        # watching|checking (writing is client-side)
        self.mode = "live"              # live|replay
        self.model = "sonnet"
        self.frame = None               # latest replay frame filename
        self.frame_n = 0
        self.checks = []                # newest first
        self.check_asap = False         # replay mode: Check now button
        self.snap_n = 0

    def snapshot(self):
        with self.lock:
            return {
                "status": self.status, "mode": self.mode, "model": self.model,
                "frame": self.frame, "frame_n": self.frame_n,
                "checks": self.checks[:30],
            }


STATE = State()

# one check at a time; one waiting slot, newest snap wins, stale snaps drop
PENDING = []
PENDING_LOCK = threading.Lock()
PENDING_EVENT = threading.Event()


def queue_check(snap_name, reason):
    with PENDING_LOCK:
        PENDING[:] = [(snap_name, reason)]
    PENDING_EVENT.set()


def next_check():
    while True:
        PENDING_EVENT.wait()
        with PENDING_LOCK:
            if PENDING:
                return PENDING.pop(0)
            PENDING_EVENT.clear()


def parse_report(text):
    """Split Claude's reply into visibility score/note, transcription, check."""
    out = {"visibility": None, "visibility_note": "", "on_page": "", "check": ""}
    field = None
    for line in text.splitlines():
        m = re.match(r"\s*(VISIBILITY|ON PAGE|CHECK)\s*:\s*(.*)", line, re.I)
        if m:
            field = m.group(1).upper()
            rest = m.group(2)
            if field == "VISIBILITY":
                score = re.match(r"\s*(\d+)\s*/\s*10\s*-?\s*(.*)", rest)
                if score:
                    out["visibility"] = int(score.group(1))
                    out["visibility_note"] = score.group(2).strip()
                else:
                    out["visibility_note"] = rest.strip()
            elif field == "ON PAGE":
                out["on_page"] = rest.strip()
            else:
                out["check"] = rest.strip()
        elif field == "ON PAGE":
            out["on_page"] += "\n" + line
        elif field == "CHECK":
            out["check"] += "\n" + line
    out["on_page"], out["check"] = out["on_page"].strip(), out["check"].strip()
    if not any([out["visibility_note"], out["on_page"], out["check"]]):
        out["check"] = text.strip()     # model ignored the format: show it anyway
    return out


def run_claude(frame_path, model):
    r = subprocess.run(
        ["claude", "-p", "--model", model, "--allowedTools=Read"],
        input=PROMPT.format(path=frame_path),
        capture_output=True, text=True, timeout=180,
    )
    return r.stdout.strip() or r.stderr.strip() or "(no response)"


def checker(frames_dir):
    while True:
        snap, reason = next_check()
        with STATE.lock:
            STATE.status = "checking"
        entry = {"time": datetime.now().strftime("%H:%M"), "snap": snap, "reason": reason}
        try:
            entry.update(parse_report(run_claude(frames_dir / snap, STATE.model)))
        except Exception:
            entry.update(visibility=None, visibility_note="", on_page="", failed=True,
                         check="Couldn't read this snapshot. Check that `claude` runs "
                               "in your terminal, then retry.")
        with STATE.lock:
            STATE.checks.insert(0, entry)
            STATE.status = "watching"


def watcher(log_path):
    """Replay mode only: tail the session log and gate like the browser does."""
    seen = 0
    dirty = False
    dirty_frames = 0
    first_done = False
    while True:
        rows = []
        if log_path.exists():
            with open(log_path, newline="") as f:
                rows = [r for r in csv.DictReader(f) if r.get("file")]
        for row in rows[seen:]:
            try:
                changed = float(row["changed_frac"]) if row["changed_frac"] else None
            except (ValueError, KeyError):
                changed = None
            with STATE.lock:
                STATE.frame = row["file"]
                STATE.frame_n += 1
                asap = STATE.check_asap
                STATE.check_asap = False
            if changed is not None and changed > DIRTY_AT:
                dirty = True
            if dirty:
                dirty_frames += 1
            settled = changed is not None and changed < STABLE_AT
            if asap or not first_done or (dirty and (settled or dirty_frames >= MAX_WAIT)):
                reason = ("asked" if asap else "first look" if not first_done
                          else "page settled" if settled else "checking in")
                queue_check(row["file"], reason)
                first_done, dirty, dirty_frames = True, False, 0
        seen = len(rows)
        time.sleep(1)


def replay(src, dst):
    """Feed a recorded session into the live dir, one frame per 1.5 s."""
    with open(src / "log.csv", newline="") as f:
        rows = list(csv.DictReader(f))
    with open(dst / "log.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=rows[0].keys())
        w.writeheader()
        f.flush()
        for row in rows:
            if row.get("file"):
                shutil.copy(src / row["file"], dst / row["file"])
            w.writerow(row)
            f.flush()
            time.sleep(1.5)


class Handler(BaseHTTPRequestHandler):
    frames_dir = None

    def log_message(self, *a):  # keep the terminal quiet
        pass

    def send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/":
            self.send(200, INDEX.read_bytes(), "text/html; charset=utf-8")
        elif path == "/state":
            self.send(200, json.dumps(STATE.snapshot()).encode(), "application/json")
        elif path.startswith("/snap/"):
            p = self.frames_dir / Path(path[len("/snap/"):]).name   # no traversal
            if p.exists() and p.suffix == ".jpg":
                self.send(200, p.read_bytes(), "image/jpeg")
            else:
                self.send(404, b"no snap", "text/plain")
        else:
            self.send(404, b"not found", "text/plain")

    def do_POST(self):
        url = urlparse(self.path)
        q = parse_qs(url.query)
        if url.path == "/snap":                      # live mode: browser sends a JPEG
            size = int(self.headers.get("Content-Length", 0))
            if not 0 < size <= 12_000_000:
                return self.send(400, b"bad size", "text/plain")
            body = self.rfile.read(size)
            with STATE.lock:
                STATE.snap_n += 1
                name = f"snap-{STATE.snap_n:04d}.jpg"
            (self.frames_dir / name).write_bytes(body)
            queue_check(name, q.get("reason", ["page settled"])[0])
            self.send(200, json.dumps({"id": name}).encode(), "application/json")
        elif url.path == "/retry":                   # re-run a failed check
            name = Path(q.get("snap", [""])[0]).name
            if (self.frames_dir / name).exists():
                queue_check(name, "retry")
                self.send(200, b"{}", "application/json")
            else:
                self.send(404, b"no snap", "text/plain")
        elif url.path == "/check":                   # replay mode: Check now
            with STATE.lock:
                STATE.check_asap = True
            self.send(200, b"{}", "application/json")
        else:
            self.send(404, b"not found", "text/plain")


def main():
    args = sys.argv[1:]
    model, port, replay_dir = "sonnet", 8763, None
    open_browser = "--no-open" not in args
    args = [a for a in args if a != "--no-open"]
    for flag, cast in (("--model", str), ("--port", int), ("--replay", str)):
        if flag in args:
            i = args.index(flag)
            v = cast(args[i + 1])
            model, port, replay_dir = (
                v if flag == "--model" else model,
                v if flag == "--port" else port,
                v if flag == "--replay" else replay_dir,
            )
            del args[i:i + 2]
    if args and args[0] == "demo":
        replay_dir = str(SAMPLE)

    if not shutil.which("claude"):
        sys.exit("The `claude` CLI is required (it does the reading): https://claude.com/claude-code\n"
                 "Install it, run `claude` once to log in, then rerun cono-check.")

    out = Path.home() / "deskcap" / ("check-" + datetime.now().strftime("%Y-%m-%d-%H%M%S"))
    out.mkdir(parents=True, exist_ok=True)

    with STATE.lock:
        STATE.model = model
        STATE.mode = "replay" if replay_dir else "live"

    if replay_dir:
        threading.Thread(target=replay, args=(Path(replay_dir).expanduser(), out), daemon=True).start()
        threading.Thread(target=watcher, args=(out / "log.csv",), daemon=True).start()
    threading.Thread(target=checker, args=(out,), daemon=True).start()

    Handler.frames_dir = out
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)

    def stop(*_):
        print(f"\nstopped. snaps kept in {out}")
        sys.exit(0)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    print(f"Cono check — http://localhost:{port}  ({STATE.mode}, model: {model})")
    print(f"snaps: {out}  ·  Ctrl-C to stop")
    if open_browser:
        subprocess.Popen(["open", f"http://localhost:{port}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    server.serve_forever()


if __name__ == "__main__":
    main()
