class Session:
    """A consented 10-minute recorded bundle (see plans/data-collection-spec.md)."""
    def __init__(self):
        self.lock = threading.Lock()
        self.active = False
        self.dir = None
        self.started = None             # epoch seconds
        self.frame_n = 0
        self.pauses = 0
        self.style_i = 0
        self.checks = []                # manifest entries, oldest first
        self.meta = {}

    def t(self):
        return int((time.time() - self.started) * 1000)

    def event(self, type_, **kw):
        with self.lock:
            if not self.active:
                return
            with open(self.dir / "events.jsonl", "a") as f:
                f.write(json.dumps({"t": self.t(), "type": type_, **kw}) + "\n")

    def start(self, meta):
        with self.lock:
            self.dir = Path.home() / "deskcap" / ("session-" + datetime.now().strftime("%Y-%m-%d-%H%M%S"))
            (self.dir / "frames").mkdir(parents=True)
            (self.dir / "snaps").mkdir()
            (self.dir / "signal.csv").write_text("t,changed_frac\n")
            self.started = time.time()
            self.frame_n = 0
            self.pauses = 0
            self.style_i = 0
            self.checks = []
            self.meta = meta
            self.active = True
        self.event("start")
        return str(self.dir)

    def next_config(self):
        with self.lock:
            cfg = SESSION_CONFIGS[self.style_i % len(SESSION_CONFIGS)]
            self.style_i += 1
            return cfg

    def manifest(self, ended_early):
        frames = len(list((self.dir / "frames").glob("*.jpg")))
        snaps = len(list((self.dir / "snaps").glob("*.jpg")))
        return {
            "version": 1,
            "started": datetime.utcfromtimestamp(self.started).isoformat() + "Z",
            "duration_s": round(time.time() - self.started),
            "ended_early": ended_early,
            "model": STATE.model,
            "camera_label": self.meta.get("camera_label", ""),
            "video_res": self.meta.get("video_res", []),
            "gating": {"dirty_at": DIRTY_AT, "stable_at": STABLE_AT,
                       "gate_ms": 250, "dense_ms": 3000},
            "consent": {"version": 1, "accepted_at": self.meta.get("accepted_at", "")},
            "counts": {"frames": frames, "snaps": snaps,
                       "checks": len(self.checks), "pauses": self.pauses},
            "checks": self.checks,
            "annotations": {},
        }

    def end(self, ended_early):
        with self.lock:
            if not self.active:
                return None
            self.active = False
        m = self.manifest(ended_early)
        (self.dir / "session.json").write_text(json.dumps(m, indent=1))
        size = sum(p.stat().st_size for p in self.dir.rglob("*") if p.is_file())
        print(f"session saved: {self.dir}  ({size / 1e6:.0f} MB)")
        print(f"config sweep:  {HERE / 'tools' / 'experiment.py'} {self.dir}")
        return {"path": str(self.dir), "mb": round(size / 1e6),
                "checks": [{"snap": c["snap"], "check": c["check"]} for c in self.checks]}


