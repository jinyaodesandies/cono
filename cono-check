#!/usr/bin/env python3
"""cono-check — Cono's checking component as a local web app.

The browser shows live video of your page (getUserMedia — any camera it
can see, including iPhone Continuity). Nothing streams anywhere: the page
diffs the video locally, and only when you pause writing does it snap one
full-resolution frame and send it here, where Claude (`claude` CLI — your
Claude Code login, no API key) reads it and reports:

  visibility n/10   what the camera can actually see
  on your page      faithful transcription, student's errors preserved
  check             hint-first: where the mistake is, never the answer

Usage:
  cono-check                     # live camera, picked in the browser
  cono-check deskview            # the Mac's Desk View camera (top-down), via deskcap
  cono-check session             # 10-minute recorded session panel open (combines: deskview session)
  cono-check demo                # no camera needed: bundled sample session
  cono-check --model opus        # pick the model (default: sonnet)
  cono-check --replay DIR        # replay any recorded session directory
  cono-check --port 9000
  cono-check --no-open           # don't open the browser automatically
Ctrl-C to stop.
"""
import csv, json, re, shutil, signal, subprocess, sys, threading, time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

HERE = Path(__file__).resolve().parent
INDEX = HERE / "index.html"
SAMPLE = HERE / "sample"


def ensure_deskcap():
    """Find the deskcap capture binary (Desk View needs AVFoundation, not a
    browser — browsers can't enumerate the deskViewCamera device), building
    it from the bundled source if needed."""
    for p in (HERE / "deskcap", HERE.parent / "deskcap" / "deskcap"):
        if p.exists():
            return p
    if shutil.which("swiftc"):
        print("building deskcap (first run, ~20 s)…")
        r = subprocess.run(["swiftc", "-O", "-framework", "AppKit", "-framework", "AVFoundation",
                            "-framework", "CoreImage", "-framework", "ImageIO",
                            "-o", str(HERE / "deskcap"), str(HERE / "deskcap.swift")])
        if r.returncode == 0:
            return HERE / "deskcap"
    sys.exit("deskcap is needed for Desk View and couldn't be built. Install the Xcode "
             "command line tools (xcode-select --install) and rerun.")

# replay-mode gating (live mode gates in the browser with the same numbers)
DIRTY_AT = 0.20       # changed_frac above this = real activity (writing, hand)
STABLE_AT = 0.10      # changed_frac below this = calm enough to read
MAX_WAIT = 5          # analyze anyway after this many frames of activity

PROMPT = """You are Cono, an AI study tutor watching a student's paper through a camera (a top-down or handheld view of the page). Read the image file: {path}

Respond in EXACTLY this plain-text format, no markdown:

VISIBILITY: n/10 - one line: what the camera sees; whether a page is in frame and which edges are cut off; whether small details (exponents, subscripts, fraction bars) are readable; note blur or glare.
ON PAGE: transcribe what is written on the page exactly as written, preserving the student's own errors - never silently correct anything. If no page or writing is visible, say what IS visible instead.
CHECK: {check_style} If nothing is readable, give one concrete tip to fix the framing."""

# during a recorded session the CHECK paragraph rotates through these, so a
# session also measures what KIND of help works; "question" is the default
CHECK_STYLES = {
    "question": "1-3 sentences checking the work. If there is a mistake, say exactly where it is (which line or step) and ask a guiding question - do not give the corrected answer. If the work looks right so far, confirm it and suggest the next step.",
    "principle": "1-3 sentences. If there is a mistake, state the relevant rule, formula or principle that is being used or misused - without pointing at any specific line and without giving the corrected answer. If the work looks right so far, name the principle that makes the next step work.",
    "point": "One sentence only. If there is a mistake, say only where to look again (which line or step) - no explanation, no question, no answer. If the work looks right so far, say so in one sentence.",
    "next-step": "1-2 sentences. Do not hunt for errors. Say what a good next step from here would be - the kind of move to make, not the worked-out result. If the page is blank or barely started, suggest how to begin without giving the method away.",
}
STYLE_ORDER = ["question", "principle", "point", "next-step"]


class State:
    """Everything the UI needs, guarded by one lock."""
    def __init__(self):
        self.lock = threading.Lock()
        self.status = "watching"        # watching|checking (writing is client-side)
        self.mode = "live"              # live|replay
        self.model = "sonnet"
        self.frame = None               # latest replay frame filename
        self.frame_n = 0
        self.checks = []                # newest first
        self.check_asap = False         # replay mode: Check now button
        self.snap_n = 0
        self.session_panel = False      # `cono-check session`: open the consent panel
        self.cap_error = None           # deskview mode: deskcap died (permission, camera busy)

    def snapshot(self):
        with self.lock:
            return {
                "status": self.status, "mode": self.mode, "model": self.model,
                "frame": self.frame, "frame_n": self.frame_n,
                "checks": self.checks[:30], "session_panel": self.session_panel,
                "session_active": SESSION.active, "cap_error": self.cap_error,
            }


STATE = State()


class Session:
    """A consented 10-minute recorded bundle (see plans/data-collection-spec.md)."""
    def __init__(self):
        self.lock = threading.Lock()
        self.active = False
        self.dir = None
        self.started = None             # epoch seconds
        self.frame_n = 0
        self.pauses = 0
        self.style_i = 0
        self.checks = []                # manifest entries, oldest first
        self.meta = {}

    def t(self):
        return int((time.time() - self.started) * 1000)

    def event(self, type_, **kw):
        with self.lock:
            if not self.active:
                return
            with open(self.dir / "events.jsonl", "a") as f:
                f.write(json.dumps({"t": self.t(), "type": type_, **kw}) + "\n")

    def start(self, meta):
        with self.lock:
            self.dir = Path.home() / "deskcap" / ("session-" + datetime.now().strftime("%Y-%m-%d-%H%M%S"))
            (self.dir / "frames").mkdir(parents=True)
            (self.dir / "snaps").mkdir()
            (self.dir / "signal.csv").write_text("t,changed_frac\n")
            self.started = time.time()
            self.frame_n = 0
            self.pauses = 0
            self.style_i = 0
            self.checks = []
            self.meta = meta
            self.active = True
        self.event("start")
        return str(self.dir)

    def next_style(self):
        with self.lock:
            style = STYLE_ORDER[self.style_i % len(STYLE_ORDER)]
            self.style_i += 1
            return style

    def manifest(self, ended_early):
        frames = len(list((self.dir / "frames").glob("*.jpg")))
        snaps = len(list((self.dir / "snaps").glob("*.jpg")))
        return {
            "version": 1,
            "started": datetime.utcfromtimestamp(self.started).isoformat() + "Z",
            "duration_s": round(time.time() - self.started),
            "ended_early": ended_early,
            "model": STATE.model,
            "camera_label": self.meta.get("camera_label", ""),
            "video_res": self.meta.get("video_res", []),
            "gating": {"dirty_at": DIRTY_AT, "stable_at": STABLE_AT,
                       "gate_ms": 250, "dense_ms": 3000},
            "consent": {"version": 1, "accepted_at": self.meta.get("accepted_at", "")},
            "counts": {"frames": frames, "snaps": snaps,
                       "checks": len(self.checks), "pauses": self.pauses},
            "checks": self.checks,
            "annotations": {},
        }

    def end(self, ended_early):
        with self.lock:
            if not self.active:
                return None
            self.active = False
        m = self.manifest(ended_early)
        (self.dir / "session.json").write_text(json.dumps(m, indent=1))
        size = sum(p.stat().st_size for p in self.dir.rglob("*") if p.is_file())
        print(f"session saved: {self.dir}  ({size / 1e6:.0f} MB)")
        return {"path": str(self.dir), "mb": round(size / 1e6),
                "checks": [{"snap": c["snap"], "check": c["check"]} for c in self.checks]}


SESSION = Session()

# one check at a time; one waiting slot, newest snap wins, stale snaps drop
PENDING = []
PENDING_LOCK = threading.Lock()
PENDING_EVENT = threading.Event()


def queue_check(snap_name, reason):
    with PENDING_LOCK:
        PENDING[:] = [(snap_name, reason)]
    PENDING_EVENT.set()


def next_check():
    while True:
        PENDING_EVENT.wait()
        with PENDING_LOCK:
            if PENDING:
                return PENDING.pop(0)
            PENDING_EVENT.clear()


def parse_report(text):
    """Split Claude's reply into visibility score/note, transcription, check."""
    out = {"visibility": None, "visibility_note": "", "on_page": "", "check": ""}
    field = None
    for line in text.splitlines():
        m = re.match(r"\s*(VISIBILITY|ON PAGE|CHECK)\s*:\s*(.*)", line, re.I)
        if m:
            field = m.group(1).upper()
            rest = m.group(2)
            if field == "VISIBILITY":
                score = re.match(r"\s*(\d+)\s*/\s*10\s*-?\s*(.*)", rest)
                if score:
                    out["visibility"] = int(score.group(1))
                    out["visibility_note"] = score.group(2).strip()
                else:
                    out["visibility_note"] = rest.strip()
            elif field == "ON PAGE":
                out["on_page"] = rest.strip()
            else:
                out["check"] = rest.strip()
        elif field == "ON PAGE":
            out["on_page"] += "\n" + line
        elif field == "CHECK":
            out["check"] += "\n" + line
    out["on_page"], out["check"] = out["on_page"].strip(), out["check"].strip()
    if not any([out["visibility_note"], out["on_page"], out["check"]]):
        out["check"] = text.strip()     # model ignored the format: show it anyway
    return out


def run_claude(frame_path, model, style="question"):
    r = subprocess.run(
        ["claude", "-p", "--model", model, "--allowedTools=Read"],
        input=PROMPT.format(path=frame_path, check_style=CHECK_STYLES[style]),
        capture_output=True, text=True, timeout=180,
    )
    return r.stdout.strip() or r.stderr.strip() or "(no response)"


def checker(frames_dir):
    while True:
        snap, reason = next_check()
        with STATE.lock:
            STATE.status = "checking"
        in_session = SESSION.active
        style = SESSION.next_style() if in_session else "question"
        t = SESSION.t() if in_session else None
        entry = {"time": datetime.now().strftime("%H:%M"), "snap": snap, "reason": reason}
        t0 = time.time()
        raw = ""
        try:
            raw = run_claude(frames_dir / snap, STATE.model, style)
            entry.update(parse_report(raw))
        except Exception:
            entry.update(visibility=None, visibility_note="", on_page="", failed=True,
                         check="Couldn't read this snapshot. Check that `claude` runs "
                               "in your terminal, then retry.")
        latency = int((time.time() - t0) * 1000)
        if in_session and SESSION.active:
            try:
                shutil.copy(frames_dir / snap, SESSION.dir / "snaps" / snap)
            except OSError:
                pass
            record = {"t": t, "snap": snap, "reason": reason, "style": style,
                      "latency_ms": latency, "visibility": entry.get("visibility"),
                      "on_page": entry.get("on_page", ""), "check": entry.get("check", ""),
                      "raw": raw, "annotation": None}
            with SESSION.lock:
                SESSION.checks.append(record)
            SESSION.event("check_done", snap=snap, reason=reason, style=style,
                          latency_ms=latency, visibility=entry.get("visibility"))
        with STATE.lock:
            STATE.checks.insert(0, entry)
            STATE.status = "watching"


def watcher(log_path, frames_dir):
    """Replay and deskview modes: tail the capture log and gate like the
    browser does. In deskview mode this thread also records the session
    bundle (dense frames + gating signal) since no client camera exists."""
    seen = 0
    dirty = False
    dirty_frames = 0
    first_done = False
    while True:
        rows = []
        if log_path.exists():
            with open(log_path, newline="") as f:
                rows = [r for r in csv.DictReader(f) if r.get("file")]
        for row in rows[seen:]:
            try:
                changed = float(row["changed_frac"]) if row["changed_frac"] else None
            except (ValueError, KeyError):
                changed = None
            with STATE.lock:
                STATE.frame = row["file"]
                STATE.frame_n += 1
                asap = STATE.check_asap
                STATE.check_asap = False
            if SESSION.active and STATE.mode == "deskview":
                with SESSION.lock:
                    SESSION.frame_n += 1
                    dense = f"frame-{SESSION.frame_n:04d}.jpg"
                try:
                    shutil.copy(frames_dir / row["file"], SESSION.dir / "frames" / dense)
                except OSError:
                    pass
                if changed is not None:
                    with SESSION.lock:
                        with open(SESSION.dir / "signal.csv", "a") as f:
                            f.write(f"{SESSION.t()},{changed:.4f}\n")
            if changed is not None and changed > DIRTY_AT:
                dirty = True
            if dirty:
                dirty_frames += 1
            settled = changed is not None and changed < STABLE_AT
            if asap or not first_done or (dirty and (settled or dirty_frames >= MAX_WAIT)):
                reason = ("asked" if asap else "first look" if not first_done
                          else "page settled" if settled else "checking in")
                queue_check(row["file"], reason)
                first_done, dirty, dirty_frames = True, False, 0
        seen = len(rows)
        time.sleep(1)


def replay(src, dst):
    """Feed a recorded session into the live dir, one frame per 1.5 s."""
    with open(src / "log.csv", newline="") as f:
        rows = list(csv.DictReader(f))
    with open(dst / "log.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=rows[0].keys())
        w.writeheader()
        f.flush()
        for row in rows:
            if row.get("file"):
                shutil.copy(src / row["file"], dst / row["file"])
            w.writerow(row)
            f.flush()
            time.sleep(1.5)


class Handler(BaseHTTPRequestHandler):
    frames_dir = None

    def log_message(self, *a):  # keep the terminal quiet
        pass

    def send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/":
            self.send(200, INDEX.read_bytes(), "text/html; charset=utf-8")
        elif path == "/state":
            self.send(200, json.dumps(STATE.snapshot()).encode(), "application/json")
        elif path.startswith("/snap/"):
            p = self.frames_dir / Path(path[len("/snap/"):]).name   # no traversal
            if p.exists() and p.suffix == ".jpg":
                self.send(200, p.read_bytes(), "image/jpeg")
            else:
                self.send(404, b"no snap", "text/plain")
        else:
            self.send(404, b"not found", "text/plain")

    def body(self):
        size = int(self.headers.get("Content-Length", 0))
        if not 0 <= size <= 12_000_000:
            return None
        return self.rfile.read(size)

    def do_POST(self):
        url = urlparse(self.path)
        q = parse_qs(url.query)
        if url.path == "/snap":                      # live mode: browser sends a JPEG
            body = self.body()
            if not body:
                return self.send(400, b"bad size", "text/plain")
            with STATE.lock:
                STATE.snap_n += 1
                name = f"snap-{STATE.snap_n:04d}.jpg"
            (self.frames_dir / name).write_bytes(body)
            if SESSION.active:
                SESSION.event("snap_sent", id=name, reason=q.get("reason", [""])[0])
            queue_check(name, q.get("reason", ["page settled"])[0])
            self.send(200, json.dumps({"id": name}).encode(), "application/json")
        elif url.path == "/session/start":
            meta = json.loads(self.body() or b"{}")
            meta["accepted_at"] = datetime.utcnow().isoformat() + "Z"
            path = SESSION.start(meta)
            self.send(200, json.dumps({"path": path}).encode(), "application/json")
        elif url.path == "/session/frame" and SESSION.active:
            body = self.body()
            if not body:
                return self.send(400, b"bad size", "text/plain")
            with SESSION.lock:
                SESSION.frame_n += 1
                name = f"frame-{SESSION.frame_n:04d}.jpg"
            (SESSION.dir / "frames" / name).write_bytes(body)
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/signal" and SESSION.active:
            pairs = json.loads(self.body() or b"[]")
            with SESSION.lock:
                with open(SESSION.dir / "signal.csv", "a") as f:
                    f.writelines(f"{int(t)},{cf:.4f}\n" for t, cf in pairs)
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/event" and SESSION.active:
            ev = json.loads(self.body() or b"{}")
            if ev.get("type") == "pause":
                with SESSION.lock:
                    SESSION.pauses += 1
            SESSION.event(ev.pop("type", "event"), **ev)
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/final" and SESSION.active:
            body = self.body()
            if body:
                (SESSION.dir / "page-final.jpg").write_bytes(body)
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/end":
            if SESSION.active and STATE.mode == "deskview" and STATE.frame:
                try:        # no client camera: the latest captured frame is the final page
                    shutil.copy(self.frames_dir / STATE.frame, SESSION.dir / "page-final.jpg")
                except OSError:
                    pass
            result = SESSION.end(json.loads(self.body() or b"{}").get("ended_early", False))
            self.send(200, json.dumps(result or {}).encode(), "application/json")
        elif url.path == "/session/annotate":       # after end: merge annotations
            notes = json.loads(self.body() or b"{}")
            mf = SESSION.dir / "session.json" if SESSION.dir else None
            if mf and mf.exists():
                m = json.loads(mf.read_text())
                by_snap = {a["snap"]: a for a in notes.get("checks", [])}
                for c in m["checks"]:
                    if c["snap"] in by_snap:
                        a = by_snap[c["snap"]]
                        c["annotation"] = {"verdict": a.get("verdict", ""), "note": a.get("note", "")}
                m["annotations"] = {"stuck": notes.get("stuck", ""), "wanted": notes.get("wanted", "")}
                mf.write_text(json.dumps(m, indent=1))
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/delete":
            d = SESSION.dir
            if d and not SESSION.active and d.parent == Path.home() / "deskcap" \
                    and d.name.startswith("session-") and d.exists():
                shutil.rmtree(d)
                self.send(200, b"{}", "application/json")
            else:
                self.send(400, b"no session to delete", "text/plain")
        elif url.path == "/retry":                   # re-run a failed check
            name = Path(q.get("snap", [""])[0]).name
            if (self.frames_dir / name).exists():
                queue_check(name, "retry")
                self.send(200, b"{}", "application/json")
            else:
                self.send(404, b"no snap", "text/plain")
        elif url.path == "/check":                   # replay mode: Check now
            with STATE.lock:
                STATE.check_asap = True
            self.send(200, b"{}", "application/json")
        else:
            self.send(404, b"not found", "text/plain")


def main():
    args = sys.argv[1:]
    model, port, replay_dir = "sonnet", 8763, None
    open_browser = "--no-open" not in args
    args = [a for a in args if a != "--no-open"]
    for flag, cast in (("--model", str), ("--port", int), ("--replay", str)):
        if flag in args:
            i = args.index(flag)
            v = cast(args[i + 1])
            model, port, replay_dir = (
                v if flag == "--model" else model,
                v if flag == "--port" else port,
                v if flag == "--replay" else replay_dir,
            )
            del args[i:i + 2]
    deskview = "deskview" in args or "deskcap" in args
    if "demo" in args:
        replay_dir = str(SAMPLE)
    if "session" in args:
        with STATE.lock:
            STATE.session_panel = True
        deskview = deskview or not replay_dir   # a recorded session means Desk View
    if "live" in args:
        deskview = False

    if not shutil.which("claude"):
        sys.exit("The `claude` CLI is required (it does the reading): https://claude.com/claude-code\n"
                 "Install it, run `claude` once to log in, then rerun cono-check.")

    out = Path.home() / "deskcap" / ("check-" + datetime.now().strftime("%Y-%m-%d-%H%M%S"))
    out.mkdir(parents=True, exist_ok=True)

    with STATE.lock:
        STATE.model = model
        STATE.mode = "replay" if replay_dir else "deskview" if deskview else "live"

    cap = None
    if replay_dir:
        threading.Thread(target=replay, args=(Path(replay_dir).expanduser(), out), daemon=True).start()
        threading.Thread(target=watcher, args=(out / "log.csv", out), daemon=True).start()
    elif deskview:
        cap = subprocess.Popen(
            [str(ensure_deskcap()), "--device", "deskview", "--interval", "1", "--out", str(out)],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
        )
        threading.Thread(target=watcher, args=(out / "log.csv", out), daemon=True).start()

        def cap_watch():
            err = (cap.stderr.read() or "").strip()
            cap.wait()
            with STATE.lock:
                STATE.cap_error = err.splitlines()[-1] if err else \
                    "The Desk View camera stopped — it may be in use by another app."
            print(f"deskcap exited: {STATE.cap_error}")
        threading.Thread(target=cap_watch, daemon=True).start()
    threading.Thread(target=checker, args=(out,), daemon=True).start()

    Handler.frames_dir = out
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)

    def stop(*_):
        if cap:
            cap.terminate()
        print(f"\nstopped. snaps kept in {out}")
        sys.exit(0)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    print(f"Cono check — http://localhost:{port}  ({STATE.mode}, model: {model})")
    print(f"snaps: {out}  ·  Ctrl-C to stop")
    if open_browser:
        subprocess.Popen(["open", f"http://localhost:{port}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    server.serve_forever()


if __name__ == "__main__":
    main()
