class Events:
    """Server-sent events: streamed check/chat text and twin updates."""
    def __init__(self):
        self.lock = threading.Lock()
        self.clients = []               # queue.Queue per connected /events client

    def register(self):
        q = queue.Queue(maxsize=400)
        with self.lock:
            self.clients.append(q)
        return q

    def unregister(self, q):
        with self.lock:
            if q in self.clients:
                self.clients.remove(q)

    def emit(self, **ev):
        data = json.dumps(ev)
        with self.lock:
            for q in self.clients:
                try:
                    q.put_nowait(data)
                except queue.Full:
                    pass


EVENTS = Events()

STAGE_FIELDS = ["VISIBILITY", "WORKING ON", "PROBLEM", "ON PAGE", "TALLY",
                "CHECK", "KIND", "GRID", "EQUATIONS"]


class Stages:
    """Per-check/chat stage timestamps — a test feature: Yao watches where
    the time goes. Every transition is a real pipeline event (never a timer):
    contrast done, request sent, first streamed token, each reply-contract
    section appearing in the stream, done. Emitted live over SSE and logged
    into session records so score-session can show where latency lives."""

    def __init__(self, cid, kind):
        self.cid, self.kind = cid, kind
        self.t0 = time.time()
        self.list = []                  # [{"stage": name, "ms": since-start}]
        self.seen = set()
        self.pending = list(STAGE_FIELDS)

    def hit(self, name):
        if name in self.seen:
            return
        self.seen.add(name)
        ms = int((time.time() - self.t0) * 1000)
        self.list.append({"stage": name, "ms": ms})
        EVENTS.emit(type="stage", kind=self.kind, id=self.cid, stage=name, ms=ms)

    def scan(self, text):
        """Called per stream delta: mark reply sections as their headers appear."""
        self.hit("first word")
        for f in list(self.pending):
            if re.search(rf"^\s*{f}\s*:", text, re.M | re.I):
                self.pending.remove(f)
                self.hit(f.lower())


STATE = State()


class Session:
    """One recorded session bundle. TESTDEV MODE: recording is always on in
    live modes — it starts at launch and runs until "End & rate" or server
    stop, with no timer (the 10-minute consented window is retired; see
    plans/data-collection-spec.md for the original shape of the bundle)."""
    def __init__(self):
        self.lock = threading.Lock()
        self.active = False
        self.dir = None
        self.started = None             # epoch seconds
        self.frame_n = 0
        self.pauses = 0
        self.style_i = 0
        self.checks = []                # manifest entries, oldest first
        self.meta = {}
        self.last_dense_ms = -10**9     # deskview dense-frame thinning clock

    def size_mb(self):
        try:
            return sum(p.stat().st_size for p in self.dir.rglob("*") if p.is_file()) / 1e6
        except OSError:
            return 0

    def t(self):
        return int((time.time() - self.started) * 1000)

    def event(self, type_, **kw):
        with self.lock:
            if not self.active:
                return
            with open(self.dir / "events.jsonl", "a") as f:
                f.write(json.dumps({"t": self.t(), "type": type_, **kw}) + "\n")

    def start(self, meta):
        with self.lock:
            if self.active:             # already recording: just merge meta
                self.meta.update(meta)
                return str(self.dir)
            self.dir = Path.home() / "deskcap" / ("session-" + datetime.now().strftime("%Y-%m-%d-%H%M%S"))
            (self.dir / "frames").mkdir(parents=True)
            (self.dir / "snaps").mkdir()
            (self.dir / "signal.csv").write_text("t,changed_frac\n")
            self.started = time.time()
            self.frame_n = 0
            self.pauses = 0
            self.style_i = 0
            self.checks = []
            self.meta = meta
            self.last_dense_ms = -10**9
            self.active = True
        self.event("start")
        print(f"recording: {self.dir}")

        def disk_watch():               # unbounded sessions: say what they cost
            mydir = self.dir
            while self.active and self.dir == mydir:
                time.sleep(600)
                if self.active and self.dir == mydir:
                    print(f"recording: {self.t() // 60000} min · {self.size_mb():.0f} MB so far")
        threading.Thread(target=disk_watch, daemon=True).start()
        return str(self.dir)

    def dense_due(self):
        """Dense-frame cadence: every 3 s for the first 10 minutes, every
        10 s after — a 2-hour class stays in the hundreds of MB, not GB."""
        t = self.t()
        with self.lock:
            if t - self.last_dense_ms < (10000 if t > 600000 else 3000):
                return False
            self.last_dense_ms = t
            return True

    def next_config(self):
        with self.lock:
            cfg = SESSION_CONFIGS[self.style_i % len(SESSION_CONFIGS)]
            self.style_i += 1
            return cfg

    def manifest(self, ended_by):
        frames = len(list((self.dir / "frames").glob("*.jpg")))
        snaps = len(list((self.dir / "snaps").glob("*.jpg")))
        return {
            "version": 2,
            "recording": "always-on-testdev",
            "started": datetime.utcfromtimestamp(self.started).isoformat() + "Z",
            "duration_s": round(time.time() - self.started),
            "ended_by": ended_by,
            "model": STATE.model,
            "camera_label": self.meta.get("camera_label", ""),
            "video_res": self.meta.get("video_res", []),
            "gating": {"dirty_at": DIRTY_AT, "stable_at": STABLE_AT,
                       "gate_ms": 250, "dense_ms": 3000, "dense_ms_after_10min": 10000},
            "counts": {"frames": frames, "snaps": snaps,
                       "checks": len(self.checks), "pauses": self.pauses},
            "checks": self.checks,
            "annotations": {},
        }

    def end(self, ended_by="user"):
        with self.lock:
            if not self.active:
                return None
            self.active = False
        m = self.manifest(ended_by)
        (self.dir / "session.json").write_text(json.dumps(m, indent=1))
        size = self.size_mb()
        print(f"session saved: {self.dir}  ({size:.0f} MB)")
        print(f"score it:      {HERE / 'tools' / 'score-session.py'} {self.dir}")
        return {"path": str(self.dir), "mb": round(size),
                "checks": [{"snap": c["snap"], "check": c["check"]} for c in self.checks]}


SESSION = Session()


class Live:
    """Latest stream frame from deskcap, fanned out to /stream clients."""
    def __init__(self):
        self.cond = threading.Condition()
        self.jpeg = None
        self.seq = 0

    def set(self, data):
        with self.cond:
            self.jpeg = data
            self.seq += 1
            self.cond.notify_all()

    def wait_next(self, seq):
        with self.cond:
            if self.seq == seq:
                self.cond.wait(5)
            return self.jpeg, self.seq


LIVE = Live()
CAP = {"proc": None, "start": None, "stopping": False, "killed": set()}   # deskview capture process


def cap_kill():
    """Stop the running deskcap on purpose (pause / reconnect) — its watcher
    must treat this exit as intended, not as a crash to report or relaunch."""
    proc = CAP["proc"]
    if proc and proc.poll() is None:
        CAP["killed"].add(proc.pid)
        proc.terminate()
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()


def stream_reader(stdout):
    """deskcap --stream emits 4-byte big-endian length + JPEG per frame."""
    while True:
        head = stdout.read(4)
        if len(head) < 4:
            return
        n = struct.unpack(">I", head)[0]
        data = b""
        while len(data) < n:
            chunk = stdout.read(n - len(data))
            if not chunk:
                return
            data += chunk
        LIVE.set(data)

# one check at a time; one waiting slot, newest snap wins, stale snaps drop
PENDING = []
PENDING_LOCK = threading.Lock()
PENDING_EVENT = threading.Event()


USER_REASONS = ("asked", "next", "retry")   # student pressed something: never evicted


def queue_check(snap_name, reason):
    with PENDING_LOCK:
        if PENDING and PENDING[0][1] in USER_REASONS and reason not in USER_REASONS:
            return                      # an automatic snap never evicts a user request
        PENDING[:] = [(snap_name, reason)]
    PENDING_EVENT.set()


def next_check():
    while True:
        PENDING_EVENT.wait()
        with PENDING_LOCK:
            if PENDING:
                return PENDING.pop(0)
            PENDING_EVENT.clear()


FIELDS_RE = re.compile(r"\s*(VISIBILITY|WORKING ON|PROBLEM|TALLY|ON PAGE|CHECK|KIND|GRID|EQUATIONS)\s*:\s*(.*)", re.I)


def parse_report(text, partial=False):
    """Split Claude's reply into its fields. With partial=True this is safe to
    call on a half-streamed reply (used to push CHECK text live over SSE)."""
    out = {"visibility": None, "visibility_note": "", "working_on": "",
           "on_page": "", "check": "", "kind": "", "problem": None,
           "grid": [], "equations": [], "tally": ""}
    field = None
    for line in text.splitlines():
        m = FIELDS_RE.match(line)
        if m:
            field = m.group(1).upper()
            rest = m.group(2)
            if field == "VISIBILITY":
                score = re.match(r"\s*(\d+)\s*/\s*10\s*-?\s*(.*)", rest)
                if score:
                    out["visibility"] = int(score.group(1))
                    out["visibility_note"] = score.group(2).strip()
                else:
                    out["visibility_note"] = rest.strip()
            elif field == "WORKING ON":
                out["working_on"] = rest.strip().strip('"')
            elif field == "PROBLEM":
                parts = [p.strip() for p in rest.split("|")]
                if parts and parts[0]:
                    out["problem"] = {"label": parts[0].strip('". ').lower(),
                                      "question": parts[1] if len(parts) > 1 else "",
                                      "progress": parts[2] if len(parts) > 2 else ""}
            elif field == "TALLY":
                t = rest.strip()
                out["tally"] = "" if t.lower() in ("none", "none.") else t
            elif field == "ON PAGE":
                out["on_page"] = rest.strip()
            elif field == "KIND":
                k = rest.strip().strip('".').lower()
                out["kind"] = k if k in ("confirm", "fix", "idle", "setup") else ""
            elif field == "GRID":
                pass                    # rows follow on their own lines
            elif field == "EQUATIONS":
                if rest.strip() and rest.strip().lower() != "none":
                    eq, _, name = rest.partition("::")
                    if eq.strip():
                        out["equations"].append({"eq": eq.strip(), "name": name.strip()})
            else:
                out["check"] = rest.strip()
        elif field == "ON PAGE":
            out["on_page"] += "\n" + line
        elif field == "CHECK":
            out["check"] += "\n" + line
        elif field == "GRID":
            row = line.strip()
            if re.fullmatch(r"[012]{2,8}", row) and len(out["grid"]) < 8:
                out["grid"].append(row)
        elif field == "EQUATIONS":
            if line.strip() and line.strip().lower() != "none" and len(out["equations"]) < 6:
                eq, _, name = line.partition("::")
                if eq.strip():
                    out["equations"].append({"eq": eq.strip(), "name": name.strip()})
    out["on_page"], out["check"] = out["on_page"].strip(), out["check"].strip()
    if partial:
        return out
    if not any([out["visibility_note"], out["on_page"], out["check"]]):
        out["check"] = text.strip()     # model ignored the format: show it anyway
    if not out["kind"]:                 # degrade gracefully when KIND is missing
        if (out["visibility"] or 0) <= 3:
            out["kind"] = "setup"
        elif "?" not in out["check"] and (out["visibility"] or 0) >= 7:
            out["kind"] = "confirm"
        else:
            out["kind"] = "fix"
    return out


ENHANCED = {}                           # snap path -> tag of the pass already applied


def clarify_strong(im):
    """The 'strong' writing-clarity pass, tuned for faint strokes:
    1. flatten uneven lighting — subtract a heavily blurred copy of the
       luminance (page-curvature shading and lamp falloff cancel out, so a
       later stretch amplifies ink, not shadows);
    2. histogram-stretch the flattened image (1% clip per end — faint
       graphite gets the full range, and because shading is already gone
       this can't turn shadows into black blobs);
    3. gamma 1.6 — mid-gray strokes darken toward black, paper stays bright;
    4. mild unsharp (r2, 80%, threshold 3) — crisper stroke edges, the
       threshold keeps paper grain from haloing.
    Output is grayscale: for reading handwriting, color is noise."""
    from PIL import ImageChops, ImageFilter
    lum = im.convert("L")
    bg = lum.filter(ImageFilter.GaussianBlur(radius=max(lum.size) // 40))
    flat = ImageChops.subtract(lum, bg, scale=1.0, offset=215)
    # clip 8% at the bright end: the page-border glow the subtraction creates
    # must not hog the range — paper itself should land near white
    flat = _PILImageOps.autocontrast(flat, cutoff=(1, 8))
    gamma = flat.point([min(255, round((v / 255) ** 1.6 * 255)) for v in range(256)])
    sharp = gamma.filter(ImageFilter.UnsharpMask(radius=2, percent=80, threshold=3))
    return sharp.convert("RGB")


def enhance_snap(path, mode):
    """Clarity-process a stored snap IN PLACE so the thumbnail, the session
    copy, and what the model reads are the same pixels. mode: "auto" =
    global histogram stretch (near-no-op on good light, a lift on faint
    pencil), "strong" = clarify_strong above. Pillow-if-present only —
    without it this is a clean skip (live-mode snaps are processed on the
    browser canvas instead and never come through here). Returns the tag
    of the applied pass, or None."""
    if not PIL_OK or mode not in ("auto", "strong"):
        return None
    tag = f"pillow-{mode}"
    with STATE.lock:
        if path in ENHANCED:
            return ENHANCED[path]       # never double-process one frame
        ENHANCED[path] = tag
    try:
        im = _PILImage.open(path)
        im = _PILImageOps.exif_transpose(im)
        out = clarify_strong(im) if mode == "strong" else \
            _PILImageOps.autocontrast(im.convert("RGB"), cutoff=1)
        out.save(path, "JPEG", quality=88)
        return tag
    except Exception as e:
        print(f"contrast skip ({Path(path).name}): {e}")
        with STATE.lock:
            ENHANCED.pop(path, None)
        return None


def shrink_for_model(path, width=1280):
    """What the model reads is a downscaled copy (cheaper tokens, no measured
    quality loss in experiments/run1); the original stays on disk as ground
    truth. Falls back to the original if sips is unavailable."""
    if width >= 1920:
        return path
    small = path.with_name(f"{path.stem}-w{width}.jpg")
    r = subprocess.run(["sips", "--resampleWidth", str(width), str(path), "--out", str(small)],
                       capture_output=True)
    return small if r.returncode == 0 and small.exists() else path


def img_block(path):
    return {"type": "image", "source": {"type": "base64", "media_type": "image/jpeg",
                                        "data": base64.b64encode(Path(path).read_bytes()).decode()}}


def crop_for_anchor(path, x, y, frac=0.38):
    """Full-res close-up around a pen-point (x, y as 0-1 fractions), via sips.
    Returns the crop path or None — callers treat the crop as best-effort."""
    try:
        r = subprocess.run(["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(path)],
                           capture_output=True, text=True, timeout=10)
        dims = dict(re.findall(r"(pixelWidth|pixelHeight):\s*(\d+)", r.stdout))
        w, h = int(dims["pixelWidth"]), int(dims["pixelHeight"])
        cw, ch = int(w * frac), int(h * frac)
        ox = min(max(int(x * w) - cw // 2, 0), w - cw)
        oy = min(max(int(y * h) - ch // 2, 0), h - ch)
        out = Path(path).with_name(f"{Path(path).stem}-crop.jpg")
        r = subprocess.run(["sips", "--cropOffset", str(oy), str(ox),
                            "--cropToHeightWidth", str(ch), str(cw), str(path), "--out", str(out)],
                           capture_output=True, timeout=10)
        return out if r.returncode == 0 and out.exists() else None
    except Exception:
        return None


def anchor_region(x, y):
    col = ["left", "middle", "right"][min(int(x * 3), 2)]
    row = ["top", "center", "bottom"][min(int(y * 3), 2)]
    return f"{row} {col}" if (row, col) != ("center", "middle") else "center"


def claude_stream(blocks, model, on_text=None, timeout=120):
    """One streaming `claude` call: content blocks in (text + base64 images),
    text streamed out. on_text(full_text_so_far) fires per delta. Returns
    (text, first_token_s). Thinking is disabled — it cost ~55 s per check."""
    msg = {"type": "user", "message": {"role": "user", "content": blocks}}
    env = {**os.environ, "MAX_THINKING_TOKENS": "0"}
    cmd = ["claude", "-p", "--model", model, "--input-format", "stream-json",
           "--output-format", "stream-json", "--include-partial-messages", "--verbose"]
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, text=True, env=env)
    killer = threading.Timer(timeout, p.kill)
    killer.start()
    t0 = time.time()
    text, first, err = "", None, ""
    try:
        p.stdin.write(json.dumps(msg) + "\n")
        p.stdin.close()
        for line in p.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("type") == "stream_event":
                d = ev["event"].get("delta") or {}
                if d.get("type") == "text_delta":
                    if first is None:
                        first = time.time() - t0
                    text += d["text"]
                    if on_text:
                        on_text(text)
            elif ev.get("type") == "result" and ev.get("is_error"):
                err = str(ev.get("result", ""))[:300]
    finally:
        killer.cancel()
        try:
            err = err or p.stderr.read()[:300].strip()
        except Exception:
            pass
        p.wait()
    if not text.strip():
        raise RuntimeError(err or "no response from claude")
    return text, first


STOPWORDS = frozenset(
    "a an and are at be but by do does for from had has have how i if in is it its me my of on or "
    "so that the their then there this to was we what when where which why will with you your".split())


def advice_toks(text):
    """Content-word token set, for advice-dedup and dispute similarity."""
    return {w for w in re.sub(r"[^a-z0-9]+", " ", (text or "").lower()).split()
            if w not in STOPWORDS}


def tok_sim(a, b):
    """Similarity of two content-word sets: Jaccard, or the overlap
    coefficient when one phrasing is a tightened rewording of the other
    (paraphrases keep the content words and shed the connective tissue)."""
    if not a or not b:
        return 0.0
    inter = len(a & b)
    return max(inter / len(a | b), inter / min(len(a), len(b)) * 0.8)


NOTHING_NEW_RE = re.compile(
    r"\b(nothing new|no new (handwriting|writing|work|ink|answers?)|"
    r"same (work|page|writing) as before|no (visible )?changes? since|"
    r"blank (printed )?(worksheet|page)|hasn'?t (written|started)|"
    r"no (student )?(work|answers?|handwriting) (is |has been )?(yet )?(visible|written))", re.I)


def guard_check(entry, reason):
    """Post-parse trust guards (called under STATE.lock).

    Nothing-new guard: a note that references no new ink never becomes a
    dialogue card - it is demoted to the quiet line; and a "nothing new"
    claim on a snap that was taken BECAUSE the page-change signal fired is
    a misfire - suppressed outright and logged (the diff that triggered
    the snap is the ground truth that something changed).

    Advice dedup: the said-it-already registry. The same advice (content-
    word similarity >= 0.6 against what was already said on this problem)
    is delivered at most twice; from the second delivery the next check's
    prompt carries an escalate-or-concede order (REPEAT_NOTE), and a third
    identical nudge is suppressed server-side to a quiet ack. Fifteen
    identical nudges (session 194928) must be impossible.
    """
    label = (entry.get("problem") or STATE.problem or {}).get("label")
    text = entry.get("check") or ""
    claims_nothing = bool(NOTHING_NEW_RE.search(text)) or \
        (entry.get("working_on") or "").strip().lower() == "nothing new"
    if claims_nothing and reason in ("page settled", "checking in"):
        entry["suppressed"] = "misfire"
        entry["kind"] = "idle"
        entry["check"] = ""
        STATE.misfires += 1
        SESSION.event("nothing_new_misfire", snap=entry.get("snap"),
                      reason=reason, said=text[:160])
        print(f"suppressed misfire ({entry.get('snap')}): \"nothing new\" on a page the diff saw change")
        return
    if entry.get("kind") in ("confirm", "fix") and claims_nothing \
            and reason not in USER_REASONS and reason != "stuck?":
        entry["suppressed"] = "nothing-new"
        entry["kind"] = "idle"          # quiet line at most, never a note card
    if entry.get("kind") == "fix" and label and text:
        toks = advice_toks(text)
        log = STATE.advice_log.setdefault(label, [])
        hit = next((e for e in log if tok_sim(toks, e["toks"]) >= 0.6), None)
        if hit is None:
            log.append({"toks": toks, "text": text, "n": 1})
        else:
            hit["n"] += 1
            hit["toks"] |= toks         # the paraphrase family grows with each variant
            entry["repeat_n"] = hit["n"]
            # a third identical nudge is forbidden (a user-requested check is
            # never left empty-handed - the ladder escalates it prompt-side)
            if hit["n"] >= 3 and reason not in USER_REASONS:
                entry["suppressed"] = "repeat"
                entry["kind"] = "idle"
                entry["check"] = f"still on {label} - the earlier note stands"
                SESSION.event("advice_suppressed", n=hit["n"], said=text[:160])
                print(f"suppressed repeat x{hit['n']} ({label}): {text[:60]}")


def fmt_problem(p):
    if not p:
        return "(not identified yet)"
    return f"{p.get('label', '?')} - {p.get('question', '')} (progress: {p.get('progress', '')})"


def fmt_thread(msgs, n=8):
    return "\n".join(f"{'Student' if m['who'] == 'you' else 'You'}: {m['text']}"
                     for m in msgs[-n:])


def build_context():
    """Everything the model remembers, under STATE.lock."""
    thread = STATE.thread()
    tblock = THREAD_BLOCK.format(lines=fmt_thread(thread)) if thread else ""
    if not (STATE.last_on_page or STATE.last_checks or STATE.problem):
        return ""
    label = (STATE.problem or {}).get("label")
    advice = STATE.advice_log.get(label, [])
    ablock = ADVICE_BLOCK.format(lines="\n".join(
        f"- {e['text']}" + (f" (said {e['n']} times)" if e["n"] > 1 else "")
        for e in advice[-6:])) if advice else ""
    return CONTEXT_BLOCK.format(
        problem=fmt_problem(STATE.problem),
        questions=QUESTIONS_BLOCK.format(qlist="\n".join(
            f"- {k}: {v}" for k, v in STATE.questions.items())) if STATE.questions else "",
        pin_note=PIN_NOTE.format(pin=STATE.pinned_label) if STATE.pinned_label else "",
        last_on_page=STATE.last_on_page[:1200] or "(none yet)",
        last_checks="\n".join(f"- {c}" for c in STATE.last_checks[-2:]) or "(none yet)",
        advice=ablock,
        thread=tblock,
    )


def absorb_twin(entry, snap, next_from=None):
    """Fold a finished check's structured fields into the twin. Under lock."""
    if entry.get("grid"):
        STATE.grid = entry["grid"]
        STATE.grid_snap = snap
        STATE.grid_time = entry["time"]
    if entry.get("kind") == "setup":
        return                          # unreadable frame: keep card + equations
    p = entry.get("problem")
    accepted = True                     # does this check's PROBLEM stand?
    if p and p.get("label"):
        label = p["label"]
        if label in STATE.questions:
            # the registry is ground truth: occlusion or a re-read never
            # rewords a question we already know (Yao: a hand over the sheet
            # is not evidence the question changed)
            p = {**p, "question": STATE.questions[label]}
        elif p.get("question") and (entry.get("visibility") or 0) >= 5:
            STATE.questions[label] = p["question"]      # new question discovered
        if next_from and label != next_from:
            # Next: pin the newly identified problem so routine re-reads of the
            # page (whose freshest work is still the OLD problem) can't snap
            # the card back. The pin dissolves when writing genuinely moves.
            STATE.pinned_label, STATE.pinned_from = label, next_from
            STATE.problem = p
        elif STATE.pinned_label and not next_from:
            if label == STATE.pinned_label:
                STATE.problem = p       # progress on the pinned problem
            elif label == STATE.pinned_from:
                accepted = False        # snap-back to the problem the student left
            else:                       # writing moved somewhere new: pin dissolves
                STATE.problem = p
                STATE.pinned_label = STATE.pinned_from = None
        else:
            STATE.problem = p
    # equations describe the check's PROBLEM: a rejected snap-back must not
    # leave the pinned card wearing the old problem's relations
    if accepted and entry.get("equations"):
        STATE.equations = entry["equations"]
    if entry.get("on_page"):
        STATE.last_on_page = entry["on_page"]


def checker(frames_dir):
    while True:
        snap, reason = next_check()
        with STATE.lock:
            STATE.checking_n += 1
            STATE.status = "checking"
            STATE.msg_id += 1
            cid = STATE.msg_id
            context = build_context()
            next_from = STATE.next_from if reason == "next" else None
            if reason == "next":
                STATE.next_from = None
            if reason == "asked" and STATE.problem:
                label = STATE.problem["label"]
                STATE.asks[label] = STATE.asks.get(label, 0) + 1
            cur_label = (STATE.problem or {}).get("label")
            # advice given twice and not acted on: the next check must escalate
            # or concede, never restate (the perception-dispute protocol's
            # non-compliance arm — see also guard_check)
            repeat_hot = any(e["n"] >= 2 for e in STATE.advice_log.get(cur_label, []))
            disputed = STATE.disputes.get(cur_label, False)
        in_session = SESSION.active
        cfg = SESSION.next_config() if in_session else \
            {"style": "question", "structure": "stream", "width": 960}
        if reason == "stuck?":
            cfg = {**cfg, "style": "next-step"}
        t = SESSION.t() if in_session else None
        entry = {"time": datetime.now().strftime("%H:%M"), "snap": snap,
                 "reason": reason, "id": cid}
        EVENTS.emit(type="check_start", id=cid, snap=snap, reason=reason)
        st = Stages(cid, "check")
        t0 = time.time()
        raw, first = "", None
        extra = ESCALATION if reason == "asked" else \
                STUCK_NOTE if reason == "stuck?" else \
                NEXT_NOTE.format(label=next_from or "the current problem") if reason == "next" else ""
        if repeat_hot or disputed:
            extra += REPEAT_NOTE
        last_push = [0.0]

        def push(text):                 # stream partial CHECK text to the browser
            st.scan(text)               # stage strip: mark sections as they appear
            now = time.time()
            done = "\nKIND" in text
            if not done and now - last_push[0] < 0.12:
                return
            last_push[0] = now
            p = parse_report(text, partial=True)
            if p["check"] or p["problem"]:
                EVENTS.emit(type="check_partial", id=cid, check=p["check"],
                            problem=p["problem"], visibility=p["visibility"],
                            working_on=p["working_on"])
        try:
            with STATE.lock:
                cmode, mode = STATE.contrast, STATE.mode
                client_enh = STATE.snap_enh.get(snap)
            if cmode == "off":
                entry["contrast"] = "off"
            elif mode == "live":        # browser processed it on the canvas pre-upload
                entry["contrast"] = f"canvas-{client_enh}" if client_enh else "skip"
            else:                       # deskview/replay: process the stored file itself
                entry["contrast"] = enhance_snap(frames_dir / snap, cmode) or "skip"
            st.hit("contrast")
            send = shrink_for_model(frames_dir / snap, cfg["width"])
            st.hit("sent")
            prompt = PROMPT.format(context=context,
                                   check_style=CHECK_STYLES[cfg["style"]],
                                   no_new_rule="" if reason == "stuck?" else NO_NEW_RULE,
                                   escalation=extra)
            raw, first = claude_stream([{"type": "text", "text": prompt}, img_block(send)],
                                       STATE.model, on_text=push)
            entry.update(parse_report(raw))
            with STATE.lock:            # remember what we saw and said
                guard_check(entry, reason)      # trust guards: dedup + nothing-new
                absorb_twin(entry, snap, next_from=next_from)
                if entry.get("check") and entry.get("kind") in ("confirm", "fix"):
                    STATE.last_checks = (STATE.last_checks + [entry["check"]])[-3:]
                    label = (entry.get("problem") or STATE.problem or {}).get("label")
                    if label:
                        entry["problem_label"] = label
                        STATE.threads.setdefault(label, []).append(
                            {"who": "cono", "text": entry["check"], "time": entry["time"],
                             "kind": entry["kind"], "snap": snap, "id": cid})
        except Exception as e:
            entry.update(visibility=None, visibility_note="", on_page="", failed=True,
                         check="Couldn't read this snapshot. Check that `claude` runs "
                               "in your terminal, then retry.")
            print(f"check failed: {e}")
        st.hit("done")
        entry["stages"] = st.list
        latency = int((time.time() - t0) * 1000)
        entry["ms"] = latency           # dev mode shows per-check latency
        first_ms = int(first * 1000) if first else None
        print(f"check {snap} ({reason}): first text "
              f"{f'{first_ms / 1000:.1f}s' if first_ms else '—'} · done {latency / 1000:.1f}s")
        if in_session and SESSION.active:
            try:
                shutil.copy(frames_dir / snap, SESSION.dir / "snaps" / snap)
            except OSError:
                pass
            record = {"t": t, "snap": snap, "reason": reason, "config": cfg,
                      "style": cfg["style"], "latency_ms": latency,
                      "first_token_ms": first_ms,
                      "contrast": entry.get("contrast", "off"),
                      "stages": entry.get("stages", []),
                      "problem": (entry.get("problem") or {}).get("label", ""),
                      "visibility": entry.get("visibility"),
                      "suppressed": entry.get("suppressed"),
                      "repeat_n": entry.get("repeat_n"),
                      "on_page": entry.get("on_page", ""), "check": entry.get("check", ""),
                      "raw": raw, "annotation": None}
            with SESSION.lock:
                SESSION.checks.append(record)
            SESSION.event("check_done", snap=snap, reason=reason, config=cfg,
                          latency_ms=latency, first_token_ms=first_ms,
                          visibility=entry.get("visibility"))
        with STATE.lock:
            STATE.checks.insert(0, entry)
            STATE.checking_n -= 1
            if STATE.checking_n <= 0:
                STATE.status = "watching"
        EVENTS.emit(type="check_done", id=cid, snap=snap)


def run_chat(cid, text, anchor, frames_dir):
    """One typed (or pen-pointed) student message → one streamed reply."""
    now = datetime.now().strftime("%H:%M")
    tag = anchor and (anchor_region(anchor["x"], anchor["y"]) if anchor["kind"] == "region"
                      else anchor["text"][:28] + ("…" if len(anchor["text"]) > 28 else ""))
    with STATE.lock:
        label = (STATE.problem or {}).get("label") or "page"
        STATE.asks[label] = STATE.asks.get(label, 0) + 1
        asks = STATE.asks[label]
        shown = text + (f"  ⌖ {tag}" if tag else "")
        STATE.threads.setdefault(label, []).append(
            {"who": "you", "text": shown, "time": now, "kind": "chat", "snap": None, "id": cid})
        problem = fmt_problem(STATE.problem)
        on_page = STATE.last_on_page[:1200] or "(none yet)"
        notes = "\n".join(f"- {c}" for c in STATE.last_checks[-2:]) or "(none yet)"
        thread = fmt_thread(STATE.threads[label][:-1]) or "(none yet)"
        img = STATE.latest_img or STATE.frame
    t0 = time.time()
    EVENTS.emit(type="chat_start", id=cid)
    st = Stages(cid, "chat")

    def push(t):
        st.hit("first word")
        EVENTS.emit(type="chat_partial", id=cid, text=t)
    anchor_note, blocks = "", []
    try:
        if anchor and anchor["kind"] != "region":
            anchor_note = ANCHOR_NOTES[anchor["kind"]].format(text=anchor["text"])
        if img and (frames_dir / img).exists():
            blocks = [img_block(shrink_for_model(frames_dir / img, 960))]
            if anchor and anchor["kind"] == "region":
                crop = crop_for_anchor(frames_dir / img, anchor["x"], anchor["y"])
                st.hit("crop")
                anchor_note = ANCHOR_NOTES["region"].format(
                    text=anchor_region(anchor["x"], anchor["y"]),
                    crop=" (a full-resolution close-up of that spot is the second image)"
                         if crop else "")
                if crop:
                    blocks.append(img_block(crop))
        prompt = CHAT_PROMPT.format(anchor_note=anchor_note, problem=problem,
                                    last_on_page=on_page, last_checks=notes,
                                    thread=thread, asks=asks, text=text)
        st.hit("sent")
        raw, first = claude_stream([{"type": "text", "text": prompt}] + blocks,
                                   STATE.model, on_text=push)
        reply = raw.strip()
    except Exception as e:
        reply = "Couldn't answer that one — check that `claude` runs in your terminal, then ask again."
        first = None
        print(f"chat failed: {e}")
    st.hit("done")
    latency = int((time.time() - t0) * 1000)
    first_ms = int(first * 1000) if first else None
    with STATE.lock:
        STATE.threads.setdefault(label, []).append(
            {"who": "cono", "text": reply, "time": datetime.now().strftime("%H:%M"),
             "kind": "chat", "snap": img, "id": cid})
        STATE.last_checks = (STATE.last_checks + [reply])[-3:]
    SESSION.event("chat_done", text=text, anchor=anchor, reply=reply,
                  asks=asks, latency_ms=latency, first_token_ms=first_ms,
                  stages=st.list)
    EVENTS.emit(type="chat_done", id=cid)
    print(f"chat ({label}, ask #{asks}): first text "
          f"{f'{first_ms / 1000:.1f}s' if first_ms else '—'} · done {latency / 1000:.1f}s")


def watcher(log_path, frames_dir):
    """Replay and deskview modes: tail the capture log and gate like the
    browser does. In deskview mode this thread also records the session
    bundle (dense frames + gating signal) since no client camera exists."""
    seen = 0
    dirty = False
    dirty_since = 0.0
    last_queued = 0.0
    last_active = 0.0
    stuck_armed = False
    first_done = False
    while True:
        rows = []
        if log_path.exists():
            with open(log_path, newline="") as f:
                rows = [r for r in csv.DictReader(f) if r.get("file")]
        if len(rows) < seen:            # deskcap was restarted and rewrote its log
            seen = 0
        for row in rows[seen:]:
            try:
                changed = float(row["changed_frac"]) if row["changed_frac"] else None
            except (ValueError, KeyError):
                changed = None
            with STATE.lock:
                STATE.frame = row["file"]
                STATE.frame_n += 1
                asap = STATE.check_asap
                STATE.check_asap = False
            if SESSION.active and STATE.mode == "deskview":
                if SESSION.dense_due():
                    with SESSION.lock:
                        SESSION.frame_n += 1
                        dense = f"frame-{SESSION.frame_n:04d}.jpg"
                    try:
                        shutil.copy(frames_dir / row["file"], SESSION.dir / "frames" / dense)
                    except OSError:
                        pass
                if changed is not None:
                    with SESSION.lock:
                        with open(SESSION.dir / "signal.csv", "a") as f:
                            f.write(f"{SESSION.t()},{changed:.4f}\n")
            now = time.time()
            if changed is not None and changed > DIRTY_AT:
                if not dirty:
                    dirty_since = now
                dirty = True
                last_active = now
                stuck_armed = True      # one nudge per writing burst
            settled = changed is not None and changed < STABLE_AT
            overdue = dirty and now - dirty_since > MAX_DIRTY_S
            gap_ok = now - last_queued >= MIN_GAP_S
            if asap or not first_done or (dirty and (settled or overdue) and gap_ok):
                reason = ("asked" if asap else "first look" if not first_done
                          else "page settled" if settled else "checking in")
                queue_check(row["file"], reason)
                first_done, dirty, last_queued = True, False, now
            elif stuck_armed and first_done and not dirty \
                    and not (STATE.cap_paused or STATE.cap_waiting) \
                    and now - max(last_active, last_queued) > STUCK_S:
                queue_check(row["file"], "stuck?")
                stuck_armed, last_queued = False, now
        seen = len(rows)
        time.sleep(1)


def replay(src, dst):
    """Feed a recorded session into the live dir, one frame per 1.5 s."""
    with open(src / "log.csv", newline="") as f:
        rows = list(csv.DictReader(f))
    with open(dst / "log.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=rows[0].keys())
        w.writeheader()
        f.flush()
        for row in rows:
            if row.get("file"):
                shutil.copy(src / row["file"], dst / row["file"])
            w.writerow(row)
            f.flush()
            time.sleep(1.5)


class Handler(BaseHTTPRequestHandler):
    frames_dir = None

    def log_message(self, *a):  # keep the terminal quiet
        pass

    def send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/":
            self.send(200, INDEX.read_bytes(), "text/html; charset=utf-8")
        elif path == "/state":
            self.send(200, json.dumps(STATE.snapshot()).encode(), "application/json")
        elif path.startswith("/snap/"):
            p = self.frames_dir / Path(path[len("/snap/"):]).name   # no traversal
            if p.exists() and p.suffix == ".jpg":
                self.send(200, p.read_bytes(), "image/jpeg")
            else:
                self.send(404, b"no snap", "text/plain")
        elif path == "/events":                      # SSE: streamed check/chat text
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            q = EVENTS.register()
            try:
                while True:
                    try:
                        data = q.get(timeout=15)
                        self.wfile.write(b"data: " + data.encode() + b"\n\n")
                    except queue.Empty:
                        self.wfile.write(b": ping\n\n")
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                return
            finally:
                EVENTS.unregister(q)
        elif path == "/stream":                      # MJPEG live view (deskview mode)
            self.send_response(200)
            self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=conoframe")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            seq = 0
            idle = 0
            try:
                while idle < 120:                    # no frame ever: give up after ~10 min
                    jpeg, nseq = LIVE.wait_next(seq)
                    if jpeg is None:
                        idle += 1
                        continue
                    # A camera that has gone away sends nothing; re-sending the last
                    # frame keeps the browser's stream open (and detects a closed tab)
                    # so the picture resumes by itself when the camera is back.
                    idle = 0
                    seq = nseq
                    self.wfile.write(b"--conoframe\r\nContent-Type: image/jpeg\r\n"
                                     b"Content-Length: " + str(len(jpeg)).encode() + b"\r\n\r\n"
                                     + jpeg + b"\r\n")
            except (BrokenPipeError, ConnectionResetError):
                return
        elif path == "/live.jpg":
            with LIVE.cond:
                j = LIVE.jpeg
            if j:
                self.send(200, j, "image/jpeg")
            else:
                self.send(404, b"no stream", "text/plain")
        else:
            self.send(404, b"not found", "text/plain")

    def body(self):
        size = int(self.headers.get("Content-Length", 0))
        if not 0 <= size <= 12_000_000:
            return None
        return self.rfile.read(size)

    def do_POST(self):
        url = urlparse(self.path)
        q = parse_qs(url.query)
        if url.path == "/snap":                      # live mode: browser sends a JPEG
            body = self.body()
            if not body:
                return self.send(400, b"bad size", "text/plain")
            with STATE.lock:
                STATE.snap_n += 1
                name = f"snap-{STATE.snap_n:04d}.jpg"
                STATE.latest_img = name
                enh = q.get("enh", ["0"])[0]
                STATE.snap_enh[name] = enh if enh in ("auto", "strong") else None
            (self.frames_dir / name).write_bytes(body)
            if SESSION.active:
                SESSION.event("snap_sent", id=name, reason=q.get("reason", [""])[0],
                              enh=STATE.snap_enh.get(name))
            if q.get("store", ["0"])[0] != "1":      # store=1: freshen only (for chat)
                queue_check(name, q.get("reason", ["page settled"])[0])
            self.send(200, json.dumps({"id": name}).encode(), "application/json")
        elif url.path == "/chat":                    # typed or pen-pointed question
            data = json.loads(self.body() or b"{}")
            text = (data.get("text") or "").strip()[:2000]
            anchor = data.get("anchor")
            if isinstance(anchor, dict):        # twin-element or map-cell pointer
                kind = anchor.get("kind")
                try:
                    if kind == "region":
                        anchor = {"kind": "region",
                                  "x": min(max(float(anchor["x"]), 0.0), 1.0),
                                  "y": min(max(float(anchor["y"]), 0.0), 1.0)}
                    elif kind in ("line", "equation", "problem") and str(anchor.get("text", "")).strip():
                        anchor = {"kind": kind, "text": str(anchor["text"]).strip()[:300]}
                    else:
                        anchor = None
                except (KeyError, TypeError, ValueError):
                    anchor = None
            else:
                anchor = None
            if not text:
                text = "What about this?" if anchor else ""
            if not text:
                return self.send(400, b"empty message", "text/plain")
            with STATE.lock:
                STATE.msg_id += 1
                cid = STATE.msg_id
            SESSION.event("chat_sent", text=text, anchor=anchor)
            threading.Thread(target=run_chat, args=(cid, text, anchor, self.frames_dir),
                             daemon=True).start()
            self.send(200, json.dumps({"id": cid}).encode(), "application/json")
        elif url.path == "/contrast":                # writing clarity: off/auto/strong
            data = json.loads(self.body() or b"{}")
            mode = data.get("mode")
            if mode not in ("off", "auto", "strong"):   # legacy {"on": bool}
                mode = "auto" if data.get("on", True) else "off"
            with STATE.lock:
                STATE.contrast = mode
            SESSION.event("contrast_set", mode=mode)
            self.send(200, json.dumps({"mode": mode}).encode(), "application/json")
        elif url.path == "/dev":                     # study <-> dev mode (display only)
            data = json.loads(self.body() or b"{}")
            with STATE.lock:
                STATE.dev = bool(data.get("on"))
                on = STATE.dev
            SESSION.event("dev_set", on=on)
            self.send(200, json.dumps({"on": on}).encode(), "application/json")
        elif url.path == "/view":                    # twin <-> ambient face (display only)
            data = json.loads(self.body() or b"{}")
            v = data.get("view")
            if v not in ("twin", "ambient"):
                return self.send(400, b"view must be twin or ambient", "text/plain")
            with STATE.lock:
                STATE.view = v
            SESSION.event("view_set", view=v)
            self.send(200, json.dumps({"view": v}).encode(), "application/json")
        elif url.path == "/suggest":                 # improvement suggestion, with context
            data = json.loads(self.body() or b"{}")
            text = (data.get("text") or "").strip()[:1000]
            if not text:
                return self.send(400, b"empty suggestion", "text/plain")
            with STATE.lock:
                last = STATE.checks[0] if STATE.checks else {}
                ctx = {"problem": STATE.problem, "last_check_id": last.get("id"),
                       "snap": last.get("snap"), "frame": STATE.latest_img or STATE.frame,
                       "mode": STATE.mode, "model": STATE.model,
                       "contrast": STATE.contrast, "dev": STATE.dev}
            rec = {"ts": datetime.now().isoformat(timespec="seconds"), "text": text,
                   "session": str(SESSION.dir) if SESSION.active else None,
                   "t_ms": SESSION.t() if SESSION.active else None, **ctx}
            jl = Path.home() / "deskcap" / "suggestions.jsonl"   # survives any one bundle
            jl.parent.mkdir(parents=True, exist_ok=True)
            with open(jl, "a") as f:
                f.write(json.dumps(rec) + "\n")
            SESSION.event("suggestion", **{k: v for k, v in rec.items() if k != "session"})
            print(f"suggestion: {text[:80]}")
            self.send(200, b"{}", "application/json")
        elif url.path == "/next":                    # problem card: Next button
            with STATE.lock:
                label = (STATE.problem or {}).get("label") or "the current problem"
                STATE.next_from = label
                mode, frame = STATE.mode, STATE.frame
            SESSION.event("next_pressed", from_problem=label)
            if mode != "live" and frame:             # live mode: the browser snaps
                queue_check(frame, "next")
            self.send(200, json.dumps({"from": label}).encode(), "application/json")
        elif url.path == "/session/start":
            meta = json.loads(self.body() or b"{}")
            path = SESSION.start(meta)   # active session: merges meta; else resumes recording
            self.send(200, json.dumps({"path": path}).encode(), "application/json")
        elif url.path == "/session/frame" and SESSION.active:
            body = self.body()
            if not body:
                return self.send(400, b"bad size", "text/plain")
            with SESSION.lock:
                SESSION.frame_n += 1
                name = f"frame-{SESSION.frame_n:04d}.jpg"
            (SESSION.dir / "frames" / name).write_bytes(body)
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/signal" and SESSION.active:
            pairs = json.loads(self.body() or b"[]")
            with SESSION.lock:
                with open(SESSION.dir / "signal.csv", "a") as f:
                    f.writelines(f"{int(t)},{cf:.4f}\n" for t, cf in pairs)
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/event" and SESSION.active:
            ev = json.loads(self.body() or b"{}")
            if ev.get("type") == "pause":
                with SESSION.lock:
                    SESSION.pauses += 1
            SESSION.event(ev.pop("type", "event"), **ev)
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/final" and SESSION.active:
            body = self.body()
            if body:
                (SESSION.dir / "page-final.jpg").write_bytes(body)
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/end":
            if SESSION.active and STATE.mode == "deskview" and STATE.frame:
                try:        # no client camera: the latest captured frame is the final page
                    shutil.copy(self.frames_dir / STATE.frame, SESSION.dir / "page-final.jpg")
                except OSError:
                    pass
            result = SESSION.end("user")
            self.send(200, json.dumps(result or {}).encode(), "application/json")
        elif url.path == "/session/annotate":       # after end: merge annotations
            notes = json.loads(self.body() or b"{}")
            mf = SESSION.dir / "session.json" if SESSION.dir else None
            if mf and mf.exists():
                m = json.loads(mf.read_text())
                by_snap = {a["snap"]: a for a in notes.get("checks", [])}
                for c in m["checks"]:
                    if c["snap"] in by_snap:
                        a = by_snap[c["snap"]]
                        c["annotation"] = {"verdict": a.get("verdict", ""), "note": a.get("note", "")}
                m["annotations"] = {"stuck": notes.get("stuck", ""), "wanted": notes.get("wanted", "")}
                mf.write_text(json.dumps(m, indent=1))
            self.send(200, b"{}", "application/json")
        elif url.path == "/session/delete":
            d = SESSION.dir
            if d and not SESSION.active and d.parent == Path.home() / "deskcap" \
                    and d.name.startswith("session-") and d.exists():
                shutil.rmtree(d)
                self.send(200, b"{}", "application/json")
            else:
                self.send(400, b"no session to delete", "text/plain")
        elif url.path == "/camera/retry":            # deskview: (re)launch deskcap — Continue / Reconnect / Skip set-up
            if CAP["start"]:
                setup = CAP.get("setup")
                if setup and setup.poll() is None:
                    CAP["setup_cancelled"] = True
                    setup.terminate()
                cap_kill()
                with STATE.lock:
                    STATE.cap_error = None
                    STATE.cap_waiting = None
                    STATE.cap_paused = False
                CAP["proc"] = CAP["start"]()
                self.send(200, b"{}", "application/json")
            else:
                self.send(400, b"camera not restartable", "text/plain")
        elif url.path == "/camera/reframe":          # deskview: re-frame the desk crop in Apple's Desk View
            if CAP["start"] and CAP.get("bin") and not STATE.cap_reframing:
                cap_kill()                           # Desk View set-up wants the camera to itself
                with STATE.lock:
                    STATE.cap_reframing = True
                    STATE.cap_error = None
                    STATE.cap_waiting = None

                def reframe():
                    setup = CAP["setup"] = subprocess.Popen([CAP["bin"], "--setup"], stdout=subprocess.DEVNULL,
                                                            stderr=subprocess.PIPE, text=True)
                    _, errs = setup.communicate()
                    cancelled = CAP.pop("setup_cancelled", False)   # user hit Skip: retry already relaunched
                    with STATE.lock:
                        STATE.cap_reframing = False
                    if cancelled:
                        return
                    err = next((l for l in reversed(errs.splitlines()) if "deskcap:" in l), "")
                    print("desk view set-up " + ("done" if setup.returncode == 0 else f"failed: {err}"))
                    with STATE.lock:
                        if setup.returncode:
                            STATE.cap_error = err or "Desk View set-up didn't finish."
                    if not CAP["stopping"] and not STATE.cap_paused and not setup.returncode:
                        CAP["proc"] = CAP["start"]()
                threading.Thread(target=reframe, daemon=True).start()
                self.send(200, b"{}", "application/json")
            else:
                self.send(400, b"not in Desk View mode", "text/plain")
        elif url.path == "/camera/pause":            # deskview: stop deskcap until Continue
            if CAP["start"]:
                cap_kill()
                with STATE.lock:
                    STATE.cap_error = None
                    STATE.cap_waiting = None
                    STATE.cap_paused = True
                self.send(200, b"{}", "application/json")
            else:
                self.send(400, b"camera not pausable", "text/plain")
        elif url.path == "/retry":                   # re-run a failed check
            name = Path(q.get("snap", [""])[0]).name
            if (self.frames_dir / name).exists():
                queue_check(name, "retry")
                self.send(200, b"{}", "application/json")
            else:
                self.send(404, b"no snap", "text/plain")
        elif url.path == "/check":                   # replay mode: Check now
            with STATE.lock:
                STATE.check_asap = True
            self.send(200, b"{}", "application/json")
        else:
            self.send(404, b"not found", "text/plain")


def doctor():
    """Preflight for running in the real world (e.g. before class)."""
    import tempfile
    ok = True

    def row(good, label, fix=""):
        nonlocal ok
        ok = ok and bool(good)
        print(("  ✓ " if good else "  ✗ ") + label)
        if not good and fix:
            print(f"      → {fix}")

    print("Cono check — preflight\n")
    row(shutil.which("claude"), "claude CLI installed",
        "install Claude Code (https://claude.com/claude-code), run `claude` once to log in")
    if shutil.which("claude"):
        h = subprocess.run(["claude", "--help"], capture_output=True, text=True, timeout=30)
        row("--include-partial-messages" in h.stdout, "claude CLI supports streaming output",
            "update Claude Code: `claude update` (streamed checks need --include-partial-messages)")
    row(shutil.which("sips"), "sips available (image downscaling)", "macOS built-in — are you on macOS?")
    bin_ = None
    try:
        bin_ = ensure_deskcap()
        row(True, "deskcap capture tool ready")
    except SystemExit as e:
        row(False, "deskcap capture tool ready", str(e))
    listing = None
    if bin_:
        lp = subprocess.Popen([str(bin_), "--list"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        try:
            listing = "".join(lp.communicate(timeout=20))
        except subprocess.TimeoutExpired:
            lp.kill()                                # don't wait: a wedged camera client may never exit
            row(False, "camera system responding",
                "listing cameras hung — the macOS camera service is wedged; quit other camera apps, "
                "unplug/re-lock the iPhone, and if it persists restart the Mac")
    if listing is not None:
        has_dv = "deskviewcamera" in listing.lower()
        row(has_dv, "Desk View camera present",
            "needs an M4-or-later Mac, or an iPhone 11+ mounted on the lid via Continuity Camera "
            "(locked, same Apple ID, Bluetooth on) — otherwise use `cono-check browser`")
        with tempfile.TemporaryDirectory() as td:
            p = subprocess.Popen([str(bin_), "--device", "deskview" if has_dv else "default",
                                  "--interval", "1", "--count", "1", "--out", td],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            try:
                _, err = p.communicate(timeout=15)
            except subprocess.TimeoutExpired:
                p.kill()
                err = b""
            errs = err.decode(errors="replace")
            denied = "permission denied" in errs
            got = any(Path(td).glob("frame-*.jpg"))
            row(got, "camera capture works from this terminal",
                "allow camera for your terminal app: System Settings → Privacy & Security → Camera"
                if denied else "close other camera apps (FaceTime, old cono-check tabs) and re-run")
    print("\nAll good — run `cono-check` and get to work." if ok
          else "\nFix the ✗ items above, then re-run `cono-check doctor`.")
    sys.exit(0 if ok else 1)


def main():
    args = sys.argv[1:]
    if "doctor" in args:
        doctor()
    model, port, replay_dir = "opus", 8764, None
    open_browser = "--no-open" not in args
    if "--no-contrast" in args:
        with STATE.lock:
            STATE.contrast = "off"
    args = [a for a in args if a not in ("--no-open", "--no-contrast")]
    if "--contrast" in args:
        i = args.index("--contrast")
        v = args[i + 1]
        if v not in ("off", "auto", "strong"):
            sys.exit("--contrast takes off, auto, or strong")
        with STATE.lock:
            STATE.contrast = v
        del args[i:i + 2]
    for flag, cast in (("--model", str), ("--port", int), ("--replay", str)):
        if flag in args:
            i = args.index(flag)
            v = cast(args[i + 1])
            model, port, replay_dir = (
                v if flag == "--model" else model,
                v if flag == "--port" else port,
                v if flag == "--replay" else replay_dir,
            )
            del args[i:i + 2]
    if "--no-record" in args:
        args.remove("--no-record")
        with STATE.lock:
            STATE.record = False
    if "--dev" in args:
        args.remove("--dev")
        with STATE.lock:
            STATE.dev = True
    if "--view" in args:
        i = args.index("--view")
        v = args[i + 1]
        if v not in ("twin", "ambient"):
            sys.exit("--view takes twin or ambient")
        with STATE.lock:
            STATE.view = v
        del args[i:i + 2]
    if "demo" in args:
        replay_dir = str(HERE / "sample-chem") if "chem" in args else str(SAMPLE)
    if "session" in args:               # no-op alias from the 10-minute era
        args.remove("session")
        print("note: recording is always on in live modes now — `session` does nothing "
              "(opt out with --no-record)")
    # Desk View IS the product: top-down on the page is the default; the
    # browser camera (selfie view) is the explicit fallback, never the default.
    deskview = not replay_dir and not ("live" in args or "browser" in args)

    if not shutil.which("claude"):
        sys.exit("The `claude` CLI is required (it does the reading): https://claude.com/claude-code\n"
                 "Install it, run `claude` once to log in, then rerun cono-check.")

    out = Path.home() / "deskcap" / ("check-" + datetime.now().strftime("%Y-%m-%d-%H%M%S"))
    out.mkdir(parents=True, exist_ok=True)

    with STATE.lock:
        STATE.model = model
        STATE.mode = "replay" if replay_dir else "deskview" if deskview else "live"

    cap = None
    if replay_dir:
        threading.Thread(target=replay, args=(Path(replay_dir).expanduser(), out), daemon=True).start()
        threading.Thread(target=watcher, args=(out / "log.csv", out), daemon=True).start()
    elif deskview:
        deskcap_bin = os.environ.get("CONO_DESKCAP") or str(ensure_deskcap())
        CAP["bin"] = deskcap_bin

        def start_cap():
            proc = subprocess.Popen(
                [deskcap_bin, "--device", "deskview", "--interval", "1",
                 "--stream", "12", "--out", str(out)],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            )
            threading.Thread(target=stream_reader, args=(proc.stdout,), daemon=True).start()

            def cap_watch():
                lines = []
                for raw in proc.stderr:
                    l = raw.decode(errors="replace").strip()
                    if not l:
                        continue
                    lines.append(l)
                    if "deskcap status:" in l:        # waiting … | lost … | live
                        msg = l.split("deskcap status:", 1)[1].strip()
                        with STATE.lock:
                            STATE.cap_waiting = None if msg == "live" else msg
                        print("camera " + ("back" if msg == "live" else msg.split(" — ")[0]))
                proc.wait()
                if CAP["stopping"] or proc.pid in CAP["killed"]:
                    CAP["killed"].discard(proc.pid)
                    return
                err = next((l for l in reversed(lines) if "deskcap:" in l), "")
                with STATE.lock:
                    STATE.cap_waiting = None
                    STATE.cap_error = err or \
                        "The Desk View camera stopped — it may be in use by another app."
                print(f"deskcap exited: {STATE.cap_error}")
                if "permission denied" not in err:  # anything else is worth another try
                    time.sleep(3)
                    if not CAP["stopping"] and CAP["proc"] is proc:
                        with STATE.lock:
                            STATE.cap_error = None
                        CAP["proc"] = start_cap()
            threading.Thread(target=cap_watch, daemon=True).start()
            return proc

        CAP["start"] = start_cap
        CAP["proc"] = cap = start_cap()
        threading.Thread(target=watcher, args=(out / "log.csv", out), daemon=True).start()
    for _ in range(2):      # two workers: a slow check never blocks the next
        threading.Thread(target=checker, args=(out,), daemon=True).start()

    Handler.frames_dir = out
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)

    def stop(*_):
        CAP["stopping"] = True
        if CAP["proc"]:
            CAP["proc"].terminate()
        elif cap:
            cap.terminate()
        if SESSION.active:              # server stop still lands a scoreable bundle
            if STATE.mode == "deskview" and STATE.frame:
                try:
                    shutil.copy(out / STATE.frame, SESSION.dir / "page-final.jpg")
                except OSError:
                    pass
            SESSION.end("server-stop")
        print(f"\nstopped. snaps kept in {out}")
        sys.exit(0)
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    # TESTDEV: live modes record from launch — demo/replay never do
    if STATE.mode in ("live", "deskview") and STATE.record:
        SESSION.start({"camera_label": "Desk View (deskcap)" if deskview else ""})
    elif STATE.mode in ("live", "deskview"):
        print("recording: OFF (--no-record)")

    print(f"Cono check — http://localhost:{port}  ({STATE.mode}, model: {model})")
    print(f"snaps: {out}  ·  Ctrl-C to stop")
    if open_browser:
        subprocess.Popen(["open", f"http://localhost:{port}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    server.serve_forever()


if __name__ == "__main__":
    main()
