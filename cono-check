class State:
    """Everything the UI needs, guarded by one lock."""
    def __init__(self):
        self.lock = threading.Lock()
        self.status = "watching"        # watching|checking (writing is client-side)
        self.mode = "live"              # live|replay
        self.model = "sonnet"
        self.frame = None               # latest replay frame filename
        self.frame_n = 0
        self.checks = []                # newest first
        self.check_asap = False         # replay mode: Check now button
        self.snap_n = 0
        self.session_panel = False      # `cono-check session`: open the consent panel
        self.cap_error = None           # deskview mode: deskcap died (permission, camera busy)
        self.last_on_page = ""          # page-state memory: latest good transcription
        self.last_checks = []           # ...and the last few notes given (don't repeat)
        self.checking_n = 0             # checks in flight (two workers)
        # --- the digital twin ---
        self.problem = None             # {"label","question","progress"} current problem card
        self.equations = []             # [{"eq","name"}] relations for the current problem
        self.grid = []                  # readability map: list of digit-strings, rows of the page
        self.grid_snap = None           # the snap the grid describes
        self.grid_time = ""
        self.threads = {}               # problem label -> [{"who","text","time","kind","snap","id"}]
        self.asks = {}                  # problem label -> explicit asks so far (ladder position)
        self.next_from = None           # label the student pressed Next on (consumed by next check)
        self.latest_img = None          # newest stored image filename (chat reads this)
        self.msg_id = 0                 # ids for checks + chat messages (SSE correlation)
        self.contrast = True            # auto contrast normalization on snaps
        self.snap_enh = {}              # live mode: snap name -> client applied contrast

    def thread(self):
        label = (self.problem or {}).get("label")
        return self.threads.setdefault(label, []) if label else []

    def snapshot(self):
        with self.lock:
            label = (self.problem or {}).get("label")
            return {
                "status": self.status, "mode": self.mode, "model": self.model,
                "frame": self.frame, "frame_n": self.frame_n,
                "checks": self.checks[:30], "session_panel": self.session_panel,
                "session_active": SESSION.active, "cap_error": self.cap_error,
                "twin": {
                    "problem": self.problem, "equations": self.equations,
                    "grid": self.grid, "grid_snap": self.grid_snap,
                    "grid_time": self.grid_time,
                },
                "thread": self.thread()[-40:],
                "asks": self.asks.get(label, 0),
                "contrast": self.contrast, "pillow": PIL_OK,
            }


class Events:
    """Server-sent events: streamed check/chat text and twin updates."""
    def __init__(self):
        self.lock = threading.Lock()
        self.clients = []               # queue.Queue per connected /events client

    def register(self):
        q = queue.Queue(maxsize=400)
        with self.lock:
            self.clients.append(q)
        return q

    def unregister(self, q):
        with self.lock:
            if q in self.clients:
                self.clients.remove(q)

    def emit(self, **ev):
        data = json.dumps(ev)
        with self.lock:
            for q in self.clients:
                try:
                    q.put_nowait(data)
                except queue.Full:
                    pass


EVENTS = Events()

STAGE_FIELDS = ["VISIBILITY", "WORKING ON", "PROBLEM", "ON PAGE", "TALLY",
                "CHECK", "KIND", "GRID", "EQUATIONS"]


class Stages:
    """Per-check/chat stage timestamps — a test feature: Yao watches where
    the time goes. Every transition is a real pipeline event (never a timer):
    contrast done, request sent, first streamed token, each reply-contract
    section appearing in the stream, done. Emitted live over SSE and logged
    into session records so score-session can show where latency lives."""

    def __init__(self, cid, kind):
        self.cid, self.kind = cid, kind
        self.t0 = time.time()
        self.list = []                  # [{"stage": name, "ms": since-start}]
        self.seen = set()
        self.pending = list(STAGE_FIELDS)

    def hit(self, name):
        if name in self.seen:
            return
        self.seen.add(name)
        ms = int((time.time() - self.t0) * 1000)
        self.list.append({"stage": name, "ms": ms})
        EVENTS.emit(type="stage", kind=self.kind, id=self.cid, stage=name, ms=ms)

    def scan(self, text):
        """Called per stream delta: mark reply sections as their headers appear."""
        self.hit("first word")
        for f in list(self.pending):
            if re.search(rf"^\s*{f}\s*:", text, re.M | re.I):
                self.pending.remove(f)
                self.hit(f.lower())


