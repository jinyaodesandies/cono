def ensure_deskcap():
    """Find the deskcap capture binary (Desk View needs AVFoundation, not a
    browser — browsers can't enumerate the deskViewCamera device), building
    it from the bundled source if needed."""
    for p in (HERE / "deskcap", HERE.parent / "deskcap" / "deskcap"):
        if p.exists():
            return p
    if not shutil.which("swiftc"):
        sys.exit("deskcap is needed for Desk View and couldn't be built. Install the Xcode "
                 "command line tools (xcode-select --install) and rerun.")
    print("building deskcap (first run, ~20 s)…")
    tmp = HERE / f".deskcap.build-{os.getpid()}"
    cmd = ["swiftc", "-O", "-framework", "AppKit", "-framework", "AVFoundation",
           "-framework", "CoreImage", "-framework", "ImageIO",
           "-o", str(tmp), str(HERE / "deskcap.swift")]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode == 0:
        os.replace(tmp, HERE / "deskcap")        # atomic: a running deskcap keeps its old file
        return HERE / "deskcap"
    tmp.unlink(missing_ok=True)
    err = r.stderr
    if "redefinition of module 'SwiftBridging'" in err:
        hint = ("a stale file from an older Command Line Tools install is shadowing the new one; "
                "remove it: sudo rm /Library/Developer/CommandLineTools/usr/include/swift/module.modulemap")
    else:
        hint = "\n".join(l.strip() for l in err.splitlines() if "error:" in l)[:600] or err[-600:]
    sys.exit(f"deskcap is needed for Desk View and couldn't be built — {hint}")

