#!/bin/sh
# Deprecated compatibility shim: `cono-check` was renamed to `cono`.
# This wrapper forwards everything and will be removed in a future
# version — call ./cono directly.
echo "note: cono-check is now cono — this compatibility shim will be removed" >&2
here=$(dirname "$0")
if [ -L "$0" ]; then
    # resolve a PATH symlink so we still find the real repo directory
    target=$(readlink "$0")
    case $target in
        /*) here=$(dirname "$target") ;;
        *)  here=$here/$(dirname "$target") ;;
    esac
fi
exec "$here/cono" "$@"
