class State:
    """Everything the UI needs, guarded by one lock."""
    def __init__(self):
        self.lock = threading.Lock()
        self.status = "watching"        # watching|checking (writing is client-side)
        self.mode = "live"              # live|replay
        self.model = "sonnet"
        self.frame = None               # latest replay frame filename
        self.frame_n = 0
        self.checks = []                # newest first
        self.check_asap = False         # replay mode: Check now button
        self.snap_n = 0
        self.session_panel = False      # `cono-check session`: open the consent panel
        self.cap_error = None           # deskview mode: deskcap died (permission, camera busy)
        self.cap_waiting = None         # deskview mode: camera missing, deskcap waiting for it
        self.cap_paused = False         # deskview mode: user paused — deskcap stopped on purpose
        self.cap_reframing = False      # deskview mode: Apple's Desk View set-up window is open
        self.last_on_page = ""          # page-state memory: latest good transcription
        self.last_checks = []           # ...and the last few notes given (don't repeat)
        self.checking_n = 0             # checks in flight (two workers)

    def snapshot(self):
        with self.lock:
            return {
                "status": self.status, "mode": self.mode, "model": self.model,
                "frame": self.frame, "frame_n": self.frame_n,
                "checks": self.checks[:30], "session_panel": self.session_panel,
                "session_active": SESSION.active, "cap_error": self.cap_error,
                "cap_waiting": self.cap_waiting, "cap_paused": self.cap_paused,
                "cap_reframing": self.cap_reframing,
            }


